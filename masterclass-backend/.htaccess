# These are never meant to be fetched over HTTP. config.php and lib.php are
# executed by PHP so they wouldn't leak anyway, but schema.sql and README.md
# would be served as plain text — and schema.sql reveals the table layout.
#
# Apache 2.4 syntax, with the 2.2 fallback for older LiteSpeed configs.

<FilesMatch "^(config\.php|config\.example\.php|lib\.php|schema\.sql|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Don't advertise the directory listing if the index is ever missing.
Options -Indexes
