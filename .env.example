# Copy to .env.local (which is gitignored) and fill in.
#
# Get a key at https://resend.com — free tier is 100 emails/day, no card.
# NEVER prefix this with NEXT_PUBLIC_, or it ships inside the browser bundle.
RESEND_API_KEY=

# Where contact-form enquiries are delivered.
CONTACT_TO=nikhilaakashkasoju@gmail.com

# Sender. The default (onboarding@resend.dev) needs no DNS setup but can ONLY
# deliver to the address that owns the Resend account. After verifying a domain
# in Resend, switch this to your own address to deliver anywhere.
CONTACT_FROM="DataForge <onboarding@resend.dev>"
